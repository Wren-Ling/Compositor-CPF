    },
    "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该选区过于精细，无法勾勒轮廓。请尝试其他容差，或打开“连续”。"
          }
        }
      }
    },
    "That shape is too large. A shape can cover up to %lld megapixels.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该形状过大。形状最多可覆盖 %lld 百万像素。"
